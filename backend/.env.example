# Comma-separated list of browser origins allowed to call the API (CORS).
# Copy this file to .env for local development.
#
# In production (Render), set env vars in the dashboard instead:
#   ALLOWED_ORIGINS = https://your-frontend.vercel.app   (exact URL, no trailing slash)
#   MODEL_URL       = https://github.com/<user>/<repo>/releases/download/<tag>/haemia_research_demo.keras
#   MODEL_TOKEN     = only needed if the GitHub repo is private (fine-grained PAT, Contents: Read-only)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
